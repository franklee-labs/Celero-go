[
  {
    "id": "high-value-user",
    "name": "High Value User",
    "description": "User with high total spending and long membership",
    "rule": {
      "type": "relation",
      "sign": "AND",
      "children": [
        {
          "id": "c-spend",
          "name": "totalSpend >= 500",
          "type": "condition",
          "sign": "GTE",
          "properties": {
            "priority": 0,
            "field": "totalSpend",
            "value": "500",
            "valueType": "Number"
          }
        },
        {
          "id": "c-level",
          "name": "memberLevel in [gold, platinum]",
          "type": "condition",
          "sign": "IN",
          "properties": {
            "priority": 0,
            "field": "memberLevel",
            "value": "[\"gold\", \"platinum\"]",
            "valueType": "List"
          }
        },
        {
          "id": "c-days",
          "name": "registeredDays >= 180",
          "type": "condition",
          "sign": "GTE",
          "properties": {
            "priority": 0,
            "field": "registeredDays",
            "value": "180",
            "valueType": "Number"
          }
        },
        {
          "id": "c-orders",
          "name": "orderCount >= 10",
          "type": "condition",
          "sign": "GTE",
          "properties": {
            "priority": 0,
            "field": "orderCount",
            "value": "10",
            "valueType": "Number"
          }
        },
        {
          "id": "c-banned",
          "name": "not banned",
          "type": "condition",
          "sign": "EQ",
          "properties": {
            "priority": 0,
            "field": "banned",
            "value": "false",
            "valueType": "Boolean"
          }
        }
      ]
    }
  },
  {
    "id": "new-user-welcome",
    "name": "New User Welcome",
    "description": "First-week new users with no orders yet",
    "rule": {
      "type": "relation",
      "sign": "AND",
      "children": [
        {
          "id": "c-newdays",
          "name": "registeredDays <= 7",
          "type": "condition",
          "sign": "LTE",
          "properties": {
            "priority": 0,
            "field": "registeredDays",
            "value": "7",
            "valueType": "Number"
          }
        },
        {
          "id": "c-neworders",
          "name": "orderCount == 0",
          "type": "condition",
          "sign": "EQ",
          "properties": {
            "priority": 0,
            "field": "orderCount",
            "value": "0",
            "valueType": "Number"
          }
        },
        {
          "id": "c-newstatus",
          "name": "status == active",
          "type": "condition",
          "sign": "EQ",
          "properties": {
            "priority": 0,
            "field": "status",
            "value": "active",
            "valueType": "String"
          }
        },
        {
          "id": "c-newbanned",
          "name": "not banned",
          "type": "condition",
          "sign": "EQ",
          "properties": {
            "priority": 0,
            "field": "banned",
            "value": "false",
            "valueType": "Boolean"
          }
        }
      ]
    }
  },
  {
    "id": "vip-access",
    "name": "VIP Access",
    "description": "Active unblocked users who are adult or verified",
    "rule": {
      "type": "relation",
      "sign": "AND",
      "children": [
        {
          "id": "c-vstatus",
          "name": "status == active",
          "type": "condition",
          "sign": "EQ",
          "properties": {
            "priority": 0,
            "field": "status",
            "value": "active",
            "valueType": "String"
          }
        },
        {
          "id": "c-vbanned",
          "name": "not banned",
          "type": "condition",
          "sign": "EQ",
          "properties": {
            "priority": 0,
            "field": "banned",
            "value": "false",
            "valueType": "Boolean"
          }
        },
        {
          "type": "relation",
          "sign": "OR",
          "children": [
            {
              "id": "c-age",
              "name": "age >= 18",
              "type": "condition",
              "sign": "GTE",
              "properties": {
                "priority": 0,
                "field": "age",
                "value": "18",
                "valueType": "Number"
              }
            },
            {
              "id": "c-verified",
              "name": "verified == true",
              "type": "condition",
              "sign": "EQ",
              "properties": {
                "priority": 0,
                "field": "verified",
                "value": "true",
                "valueType": "Boolean"
              }
            }
          ]
        }
      ]
    }
  }
]
